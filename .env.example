# Copy to .env for local development. Values here match docker-compose.yml's dev-only
# credentials -- never put real secrets in this file, only in .env (gitignored).

DATABASE_URL=postgresql://sentrilog_app:sentrilog_app_dev_password@localhost:5432/sentrilog

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=sentrilog
S3_SECRET_KEY=sentrilog123
S3_BUCKET=sentrilog-documents
S3_REGION=us-east-1

# Rate limit: requests allowed per API key per window.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Max upload size accepted for presigned PUT validation, in bytes (10 MiB).
MAX_UPLOAD_BYTES=10485760

# LLM / embeddings -- Gemini (active provider; swappable, see services/pipeline/extraction/vlm.py).
# Get a free-tier key from https://aistudio.google.com/ -- do NOT put a real key in this file,
# only in .env. Free-tier data-usage terms differ from paid: only send synthetic test images
# through it, never real ID/selfie data (see PLAN.md Phase 4).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Bounded retry for VLM structured extraction.
EXTRACTION_MAX_RETRIES=3
